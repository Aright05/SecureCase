# ==============================================================================
# SecureCase — Master Git Ignore Configuration
# ==============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js & Frontend Tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx

# Local Databases (SQLite)
*.db
*.db-journal
*.sqlite
*.sqlite3
storage/*.db
storage/*.sqlite
storage/*.sqlite3
backend/storage/*.db
backend/storage/*.sqlite
backend/storage/*.sqlite3

# Private Document Storage & Ingested Evidence
# Documents and evidence files must NEVER be tracked in version control
storage/documents/*
!storage/documents/.gitkeep
backend/storage/documents/*
!backend/storage/documents/.gitkeep

# IDEs & System Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
