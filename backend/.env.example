# ==============================================================================
# SecureCase Backend — Environment Configuration Template
# Copy this file to .env before starting the backend server locally.
# NEVER commit the active .env file or real secrets to version control.
# ==============================================================================

# Application Settings
APP_NAME=SecureCase
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api
HOST=127.0.0.1
PORT=8000

# CORS Configuration (JSON array of allowed frontend origins)
# Allows standard Vite dev server origin by default
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration
# Default: Local SQLite database for rapid zero-dependency development
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/securecase
DATABASE_URL=sqlite:///./storage/securecase.db

# Storage Directory for Private Documents and Evidence
# Stored outside of frontend and web root to prevent direct URL access
STORAGE_DIR=../storage/documents
MAX_UPLOAD_SIZE_MB=25

# Cryptographic and JWT Security (Placeholder for Stage 3)
SECRET_KEY=securecase-dev-placeholder-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
